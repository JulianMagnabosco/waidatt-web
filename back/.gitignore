# ==========================================
# Django & Python .gitignore Template
# ==========================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Local development environments
.env
.venv
env/
venv/
ENV/
*.env

# Django specific artifacts
db.sqlite3
db.sqlite3-journal
local_settings.py
*.log

# Media and Static directories
# (Keep the directories, ignore the generated/uploaded contents)
media/
staticfiles/
static_cdn/

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Testing and Coverage
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.tox/
.nox/

# Packages and Builds
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
